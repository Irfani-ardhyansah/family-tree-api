# Copy ke .env lalu sesuaikan sebelum docker compose up:
#   cp .env.docker.example .env

# Server
PORT=3000
NODE_ENV=production

# Database (host `db` = service MySQL di docker-compose)
DB_HOST=db
DB_PORT=3306
DB_USER=family
DB_PASSWORD=changeme
DB_NAME=family_tree
DB_SSL=false
MYSQL_ROOT_PASSWORD=rootchangeme

# Set true sekali untuk isi data demo, lalu matikan lagi
RUN_SEED=false

# CORS — WAJIB origin FE eksplisit di production (bukan *)
# Ganti dengan IP/hostname STB + port FE kamu
CORS_ORIGINS=http://192.168.1.50:5173,http://localhost:5173

# Auth — ganti JWT_SECRET (min 32 karakter)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter!!
ACCESS_TTL=3600
REFRESH_TTL_REMEMBER=2592000
REFRESH_TTL_SESSION=86400
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Media — ganti host sesuai IP/hostname STB
MEDIA_STORAGE_DIR=./uploads/media
MEDIA_PUBLIC_BASE_URL=http://192.168.1.50:3000/media
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_PENDING_TTL_MS=86400000
MEDIA_TTL_INTERVAL_MS=3600000

# Web Push (opsional) — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@familyroots.local

SECONDARY_UNLOCK_TTL=900
