# Server
PORT=3000
NODE_ENV=development

# Database (Knex / mysql2)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=family_tree
# DSN equivalent: mysql://root@localhost:3306/family_tree

# CORS — comma-separated FE origins (no spaces required)
# Development: * allows any origin (credentials OK via reflect)
# Production: MUST be explicit, e.g. http://localhost:5173,https://familyroots.app
CORS_ORIGINS=*

# Auth — JWT + refresh (Part 3+)
JWT_SECRET=change-me-in-production-min-32-chars-dev
ACCESS_TTL=3600
REFRESH_TTL_REMEMBER=2592000
REFRESH_TTL_SESSION=86400

# Login rate limit (Part 3)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Media upload (local disk; see docs/requests/from-fe/done/MEDIA-UPLOAD-API.md)
MEDIA_STORAGE_DIR=./uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_PENDING_TTL_MS=86400000
MEDIA_TTL_INTERVAL_MS=3600000

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
# Kosong di development = push no-op (inbox tetap jalan)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@familyroots.local

# Secondary password unlock TTL (seconds, default 900 = 15m)
SECONDARY_UNLOCK_TTL=900

