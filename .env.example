# Server
PORT=3000
NODE_ENV=development

# Database (Knex / mysql2) — local npm run dev
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=family_tree
# Homelab/Docker MySQL tanpa TLS: false. Cloud managed MySQL: true (default di production)
DB_SSL=false
# DSN equivalent: mysql://root@localhost:3306/family_tree

# CORS — comma-separated FE origins (no spaces required)
# Local: * OK. Production/Docker: pakai .env.docker (origin eksplisit)
CORS_ORIGINS=*

# Auth — JWT + refresh (Part 3+)
JWT_SECRET=change-me-in-production-min-32-chars-dev
ACCESS_TTL=3600
REFRESH_TTL_REMEMBER=2592000
REFRESH_TTL_SESSION=86400

# Login rate limit (Part 3)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Media upload (local disk; see docs/requests/from-fe/done/MEDIA-UPLOAD-API.md)
MEDIA_STORAGE_DIR=./uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
# Max size per file (bytes). Default 5 MB = 5242880
MEDIA_MAX_FILE_BYTES=5242880
# Max attach count per purpose (photos/files on one entity)
MEDIA_MAX_COUNT_EVENT=10
MEDIA_MAX_COUNT_EVENT_CONTRIBUTION=10
MEDIA_MAX_COUNT_MEMORIAM_TRIBUTE=8
MEDIA_MAX_COUNT_PERSON=1
MEDIA_MAX_COUNT_MONEY_TRANSACTION=3
MEDIA_MAX_COUNT_MONEY_CASH_WITHDRAWAL=3
MEDIA_MAX_COUNT_MONEY_WISHLIST=1
MEDIA_MAX_COUNT_FC_DOCUMENT=5
MEDIA_PENDING_TTL_MS=86400000
MEDIA_TTL_INTERVAL_MS=3600000

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
# Kosong di development = push no-op (inbox tetap jalan)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@familyroots.local

# Secondary password unlock TTL (seconds, default 900 = 15m)
SECONDARY_UNLOCK_TTL=900

# Family Core — AES-256 key for document numbers (32 bytes as base64, or 64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FC_DOCUMENT_NUMBER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

